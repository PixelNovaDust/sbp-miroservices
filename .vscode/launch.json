  "compounds": [
    {
      "name": "Microservices (dev)",
      "configurations": ["Auth (dev)", "Users (dev)", "Admin (dev)", "Gateway (dev)"],
      "stopAll": true
    },
    {
      "name": "Domain services (dev)",
      "configurations": [
        "Reference (dev)",
        "Studio (dev)",
        "Person (dev)",
        "Content (dev)"
      ],
      "stopAll": true
    },
    {
      "name": "Infra + apps (dev)",
      "configurations": [
        "Discovery (dev)",
        "Auth (dev)",
        "Users (dev)",
        "Admin (dev)",
        "Gateway (dev)"
      ],
      "stopAll": true
    },
    {
      "name": "Full stack (dev)",
      "configurations": [
        "Discovery (dev)",
        "Auth (dev)",
        "Users (dev)",
        "Admin (dev)",
        "Gateway (dev)"
      ],
      "stopAll": true
    },
    {
      "name": "All services (dev)",
      "configurations": ["Gateway (dev)", "Auth (dev)", "Users (dev)"],
      "stopAll": true
    }
  ]
