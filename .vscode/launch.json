{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "java",
      "name": "Gateway (dev)",
      "request": "launch",
      "cwd": "${workspaceFolder}/sbp-api-gateway",
      "mainClass": "com.sbp.gateway.SbpApiGatewayApplication",
      "projectName": "sbp-api-gateway",
      "envFile": "${workspaceFolder}/env/.env.dev",
      "vmArgs": "-Dspring.profiles.active=dev -Duser.timezone=Asia/Kolkata"
    },
    {
      "type": "java",
      "name": "Auth (dev)",
      "request": "launch",
      "cwd": "${workspaceFolder}/sbp-auth-services",
      "mainClass": "com.sbp.auth.SbpAuthServicesApplication",
      "projectName": "sbp-auth-services",
      "envFile": "${workspaceFolder}/env/.env.dev",
      "vmArgs": "-Dspring.profiles.active=dev -Duser.timezone=Asia/Kolkata"
    },
    {
      "type": "java",
      "name": "Users (dev)",
      "request": "launch",
      "cwd": "${workspaceFolder}/sbp-user-services",
      "mainClass": "com.sbp.user.SbpUserServicesApplication",
      "projectName": "sbp-user-services",
      "envFile": "${workspaceFolder}/env/.env.dev",
      "vmArgs": "-Dspring.profiles.active=dev -Duser.timezone=Asia/Kolkata"
    }
  ],
  "compounds": [
    {
      "name": "All services (dev)",
      "configurations": ["Gateway (dev)", "Auth (dev)", "Users (dev)"],
      "stopAll": true
    }
  ]
}
