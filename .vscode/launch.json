{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "java",
      "name": "Discovery (dev)",
      "request": "launch",
      "cwd": "${workspaceFolder}/sbp-discovery-server",
      "mainClass": "com.sbp.discovery.SbpDiscoveryServerApplication",
      "projectName": "sbp-discovery-server",
      "envFile": "${workspaceFolder}/env/.env.dev",
      "vmArgs": "-Dspring.profiles.active=dev -Duser.timezone=Asia/Kolkata"
    },
    {
      "type": "java",
      "name": "Gateway (dev)",
      "request": "launch",
      "cwd": "${workspaceFolder}/sbp-api-gateway",
