# --- Object storage (S3-compatible: AWS S3, Cloudflare R2, MinIO) ---
# Only sbp-file-storage-service uses SBP_STORAGE_* (+ AWS SDK env below).
# Other services call file-storage over FILE_STORAGE_SERVICE_URL (no direct S3).
# Copy this file to env/.env.dev and set real bucket + credentials to test uploads.
# Seed register-reference does NOT upload bytes; use POST /api/v1/files/upload or profile-image.
SBP_STORAGE_ENABLED=true
SBP_STORAGE_PROVIDER=S3
SBP_STORAGE_REGION=ap-south-1
SBP_STORAGE_DEFAULT_BUCKET=
SBP_STORAGE_ENDPOINT=
SBP_STORAGE_KEY_PREFIX=dev/
SBP_STORAGE_PATH_STYLE=false
SBP_STORAGE_PRESIGN_UPLOAD_TTL=PT15M
SBP_STORAGE_PRESIGN_DOWNLOAD_TTL=PT1H
FILE_STORAGE_MAX_UPLOAD_SIZE=500MB

# AWS SDK default credentials (required for real PUT/HEAD when SBP_STORAGE_ENABLED=true)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional; defaults to SBP_STORAGE_REGION when unset
AWS_REGION=

# --- Cloudflare R2 (uncomment and replace; keep SBP_STORAGE_PROVIDER=S3) ---
# SBP_STORAGE_REGION=auto
# SBP_STORAGE_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# SBP_STORAGE_DEFAULT_BUCKET=your-r2-bucket-name
# SBP_STORAGE_PATH_STYLE=false
# AWS_ACCESS_KEY_ID=<R2 API token access key id>
# AWS_SECRET_ACCESS_KEY=<R2 API token secret>

# --- Local MinIO (uncomment; run MinIO on :9000 or add to compose) ---
# SBP_STORAGE_PROVIDER=MINIO
# SBP_STORAGE_REGION=us-east-1
# SBP_STORAGE_ENDPOINT=http://localhost:9000
# SBP_STORAGE_DEFAULT_BUCKET=sbp-dev-media
# SBP_STORAGE_PATH_STYLE=true
# AWS_ACCESS_KEY_ID=minioadmin
# AWS_SECRET_ACCESS_KEY=minioadmin

# --- DB/metadata only (no object store); uploads will fail until storage is configured ---
# SBP_STORAGE_ENABLED=false

# Service ports (local IDE / VS Code; Docker maps these from compose)
GATEWAY_PORT=8080
GATEWAY_MANAGEMENT_PORT=9080
AUTH_PORT=8081
AUTH_MANAGEMENT_PORT=9081
USER_PORT=8082
USER_MANAGEMENT_PORT=9082
ADMIN_PORT=8083
ADMIN_MANAGEMENT_PORT=9083
PERSON_PORT=8084
PERSON_MANAGEMENT_PORT=9084
STUDIO_PORT=8085
STUDIO_MANAGEMENT_PORT=9085
CONTENT_PORT=8086
CONTENT_MANAGEMENT_PORT=9086
REFERENCE_PORT=8087
REFERENCE_MANAGEMENT_PORT=9087
FILE_STORAGE_PORT=8088
FILE_STORAGE_MANAGEMENT_PORT=9088

# Local service base URLs (direct, not via gateway; JVM on host)
# Docker Compose overrides to http://sbp-*-service:PORT inside the stack.
AUTH_SERVICE_URL=http://localhost:8081
USER_SERVICE_URL=http://localhost:8082
ADMIN_SERVICE_URL=http://localhost:8083
PERSON_SERVICE_URL=http://localhost:8084
STUDIO_SERVICE_URL=http://localhost:8085
CONTENT_SERVICE_URL=http://localhost:8086
REFERENCE_SERVICE_URL=http://localhost:8087
FILE_STORAGE_SERVICE_URL=http://localhost:8088

# Eureka instance hostnames (use Docker service names when apps run in compose)
EUREKA_INSTANCE_HOSTNAME=localhost

MONITORING_HEALTH_CONNECT_TIMEOUT_MS=2000
MONITORING_HEALTH_READ_TIMEOUT_MS=3000
MONITORING_CACHE_TTL_SECONDS=15
MONITORING_TRUSTED_HOST_SUFFIXES=sbp-auth-service,sbp-user-service,sbp-person-service,sbp-studio-service,sbp-content-service,sbp-reference-service,sbp-file-storage-service,sbp-api-gateway,sbp-admin-service,sbp-discovery-server,auth-db,user-db,person-db,studio-db,content-db,reference-db,file-storage-db,localhost,127.0.0.1
