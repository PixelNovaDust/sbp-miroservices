SPRING_PROFILES_ACTIVE=dev
APP_TIMEZONE=Asia/Kolkata

# Auth database (host port 5432 when using make db-dev)
AUTH_DB_HOST=localhost
AUTH_DB_NAME=sbp_auth_dev
AUTH_DB_USERNAME=auth_user
AUTH_DB_PASSWORD=change-me
AUTH_DB_PORT=5432

# User database (host port 5433 when using make db-dev)
USER_DB_HOST=localhost
USER_DB_NAME=sbp_user_dev
USER_DB_USERNAME=sbp_user
USER_DB_PASSWORD=change-me
USER_DB_PORT=5433

# Service ports (local IDE / VS Code)
GATEWAY_PORT=8080
AUTH_PORT=8081
USER_PORT=8082

# Downstream URLs (gateway)
AUTH_SERVICE_URL=http://localhost:8081
USER_SERVICE_URL=http://localhost:8082
