	"connections": {
		"postgres-jdbc-sbp-dev-user": {
			"provider": "postgresql",
			"driver": "postgres-jdbc",
			"name": "SBP User (dev)",
			"description": "Local dev Postgres (USER) from env/.env.dev",
			"save-password": true,
			"folder": "SBP Dev",
			"configuration": {
				"host": "localhost",
				"port": "5433",
				"database": "sbp_user_dev",
				"url": "jdbc:postgresql://localhost:5433/sbp_user_dev?user\u003dsbp_user\u0026password\u003d8e2c1a0f5d3b9476",
				"configurationType": "URL",
				"type": "dev",
				"closeIdleConnection": false,
				"properties": {
					"connectTimeout": "20",
					"password": "8e2c1a0f5d3b9476",
					"loginTimeout": "20",
					"escapeSyntaxCallMode": "callIfNoReturn",
					"user": "sbp_user"
				},
				"provider-properties": {
					"@dbeaver-chosen-role@": "",
					"@dbeaver-show-template-db@": "false",
					"@dbeaver-show-unavailable-db@": "false",
					"show-database-statistics": "false",
					"@dbeaver-read-all-data-types-db@": "false",
					"read-keys-with-columns": "false",
					"replace-legacy-timezone": "true",
					"@dbeaver-use-prepared-statements-db@": "false",
					"postgresql.dd.plain.string": "false",
					"postgresql.dd.tag.string": "false",
					"@dbeaver-show-non-default-db@": "false"
				},
				"auth-model": "native"
			}
		},
