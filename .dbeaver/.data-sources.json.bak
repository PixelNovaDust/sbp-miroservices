    "postgres-jdbc-sbp-dev-auth": {
      "provider": "postgresql",
      "driver": "postgres-jdbc",
      "name": "SBP Auth (dev)",
      "description": "Local dev Postgres (AUTH) from env/.env.dev",
      "folder": "SBP Dev",
      "save-password": false,
      "read-only": false,
      "configuration": {
        "host": "localhost",
        "port": "5432",
        "database": "sbp_auth_dev",
        "url": "jdbc:postgresql://localhost:5432/sbp_auth_dev?user=auth_user&password=f4a8c3e21d9b6075",
        "configurationType": "URL",
        "type": "dev",
        "properties": {
          "connectTimeout": "20",
          "loginTimeout": "20",
          "user": "auth_user",
          "password": "f4a8c3e21d9b6075"
        },
        "auth-model": "native",
        "auth-properties": {
          "userName": "auth_user",
