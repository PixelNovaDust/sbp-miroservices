# Build
**/target/
!.mvn/wrapper/maven-wrapper.jar

# IDE
.idea/
.cursor/
*.iml
*.ipr
*.iws
.project
.classpath
.settings/
.factorypath
.apt_generated
.springBeans
.sts4-cache
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/
build/
!**/src/main/**/build/
!**/src/test/**/build/

# OS
.DS_Store
Thumbs.db

# Logs & debug
*.log
*.err
*-startup.log
*-startup.err
debug-*.log

# Environment & secrets (commit only env/*.example templates)
.env
.env.*
!.env.example
env/.env.*
!env/.env.dev.example
!env/.env.prod.example

# Local service runtime (scripts/run.ps1 start/stop)
scripts/.runtime/

# DBeaver (generated from env/.env.dev via scripts/sync-dbeaver.ps1; may contain dev DB passwords)
.dbeaver/credentials-config.json
.dbeaver/data-sources.json

# Credentials & keys
**/*.pem
**/*.key
**/*.p12
**/*.jks
**/credentials.json
**/secrets/
